# Postgres connection string from your Neon project (pooled connection).
DATABASE_URL=

# Auth.js. Generate with: npx auth secret
AUTH_SECRET=
# Set to your deployed URL in production (e.g. https://carpool.example.org).
# Not needed for local dev.
AUTH_URL=

# Resend (transactional email -- magic links + match notifications).
# Free tier: https://resend.com
RESEND_API_KEY=
EMAIL_FROM="Sasta Pathao <onboarding@resend.dev>"

# No key needed for OpenStreetMap map tiles or Photon geocoding -- both are
# public, free, no-signup services. See lib/geocode.ts.
