# Postgres connection string from your Neon project (pooled connection).
DATABASE_URL=

# Auth.js. Generate with: npx auth secret
AUTH_SECRET=
# Set to your deployed URL in production (e.g. https://carpool.example.org).
# Not needed for local dev.
AUTH_URL=

# Resend (transactional email -- magic links + match notifications).
# Free tier: https://resend.com
RESEND_API_KEY=
EMAIL_FROM="Sasta Pathao <onboarding@resend.dev>"

# Photon (free, no-signup geocoding) is the default if GOOGLE_MAPS_API_KEY
# below is unset -- see lib/geocode.ts.

# Optional: switches both address search/geocoding and the map tiles over to
# Google Maps (better autocomplete quality than Photon). Get a free "Demo
# Key" with no credit card at mapsplatform.google.com/maps-demo-key -- note
# Google's own docs say it's daily-capped and not meant for production, so
# this is really an evaluation/comparison knob, not a permanent choice.
# Same key value in both -- GOOGLE_MAPS_API_KEY is used server-only
# (lib/geocode.ts); NEXT_PUBLIC_GOOGLE_MAPS_API_KEY is exposed to the
# browser, which the Maps JS API requires.
GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Web Push (optional browser notifications, no cost/account needed -- these
# are a real keypair you generate yourself, not a third-party API key).
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
