# Postgres connection string from your Neon project (pooled connection).
DATABASE_URL=

# Auth.js. Generate with: npx auth secret
AUTH_SECRET=
# Comma-separated emails allowed onto /admin (user list, ban/unban). See
# lib/admin.ts.
ADMIN_EMAILS=

# Secret Vercel Cron sends as `Authorization: Bearer $CRON_SECRET` when it
# hits app/api/cron/purge-old-data (schedule in vercel.json) -- generate any
# random string. Optional for local dev (the route skips the check if this
# is unset), but set it in production so the purge endpoint can't be
# triggered by anyone who finds the URL.
CRON_SECRET=

# Profile picture uploads (Vercel Blob). Create a free Blob store in your
# Vercel project's Storage tab and it'll inject this automatically in
# production; for local dev, copy the token it shows you, or run
# `vercel env pull .env.local` once the project is linked.
BLOB_READ_WRITE_TOKEN=
# Set to your deployed URL in production (e.g. https://carpool.example.org).
# Not needed for local dev.
AUTH_URL=

# Resend (transactional email -- magic links + match notifications).
# Free tier: https://resend.com
RESEND_API_KEY=
EMAIL_FROM="Sasta Pathao <onboarding@resend.dev>"

# Google Maps -- this branch requires a real, billing-enabled key (unlike
# main, there's no free-tier fallback). Two SEPARATE keys, restricted
# differently -- see CLAUDE.md and the Google Cloud Console setup steps:
#
# GOOGLE_MAPS_API_KEY (server-only, never sent to the browser): powers
# address search/autocomplete (lib/geocode.ts, Places API (New)), reverse
# geocoding (lib/geocode.ts, Geocoding API), and the drawn route
# (lib/directions.ts, Directions API) -- all called from our own
# app/api/geocode/* routes. Restrict it to just those 3 APIs; don't add an
# HTTP referrer restriction (server-to-server calls have no browser
# referrer to check).
GOOGLE_MAPS_API_KEY=
#
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY (public -- loads via a <script> tag, so
# it's visible in the page source, same as any client-side Google Maps
# key): only powers the Maps JavaScript API (map tiles/pins/route line
# rendering, components/google-maps-provider.tsx). Restrict it to just that
# one API, and lock it down with an HTTP referrer restriction (your
# domain(s) + http://localhost:3000 for dev) instead of relying on secrecy.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Web Push (optional browser notifications, no cost/account needed -- these
# are a real keypair you generate yourself, not a third-party API key).
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Email of our barber partner account (must already be a registered user).
# Grants access to redeem riders' $5 ride-completion coupons at /coupons/[code].
# See lib/partner.ts. Optional -- the redeem feature is just hidden without it.
PARTNER_BARBER_EMAIL=
